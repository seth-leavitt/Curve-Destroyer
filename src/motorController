#include "xc.h"


int setup(){
    _RCDIV = 0;
    
    OC1RS = 166;
    OC2RS = 166;
    
    OC1CON1 = 0x1C06;
    OC1CON2 = 0x001F;
    
    OC2CON1 = 0x1C06;
    OC2CON2 = 0x001F;
    
    TRISA = 0x0000;
    TRISB = 0x0000;
    
    ANSA = 0;
    ANSB = 0;
        
    return 0;
}

void motor_left(int duty, int direction){
    if (direction == 1){
        LATBbits.LATB2 = 1;
        LATBbits.LATB1 = 0;
    } else if (direction == -1){
        LATBbits.LATB2 = 0;
        LATBbits.LATB1 = 1;
    }
    OC1R = (OC1RS * duty)/100;
}

void motor_right(int duty, int direction){
    if (direction == 1){
        LATAbits.LATA2 = 0;
        LATBbits.LATB15 = 1;
    } else if (direction == -1){
        LATAbits.LATA2 = 1;
        LATBbits.LATB15 = 0;
    }
    OC2R = (OC2RS * duty)/100;
}

int main(void) {
